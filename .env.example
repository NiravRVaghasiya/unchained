# Copy to .env and fill in the values you need. Never commit your real .env.
# Unchained reads these from the environment when you don't pass keys explicitly.

# OpenAI (provider="openai")
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (provider="anthropic")
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Ollama (provider="ollama") runs locally and needs no key.
# Override the endpoint only if it isn't the default:
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the base URL for the other providers too. This is what
# lets provider="openai" target any OpenAI-compatible endpoint (Groq,
# Together, OpenRouter, vLLM, LM Studio, ...) without changing any code -
# just point the env var at it and keep provider="openai".
# OPENAI_BASE_URL=https://api.groq.com/openai
# ANTHROPIC_BASE_URL=https://api.anthropic.com
